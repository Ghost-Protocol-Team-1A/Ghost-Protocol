# Copy to .env and adjust. Never commit .env.

# Backend
GP_STORAGE_DIR=backend/data/evidence
MAX_UPLOAD_MB=50
GP_CORS_ORIGINS=http://localhost:3000
# Optional. Turns on AI suggestions, briefings and Q&A (Claude Sonnet 5.5).
# Without it every AI button explains that AI is off; nothing else changes.
ANTHROPIC_API_KEY=
# Only for an organisation-level key: the workspace ID it spends from (wrkspc_...).
ANTHROPIC_WORKSPACE_ID=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
